    "batch.busy.message" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"已选择的模拟器中有设备正在执行其他操作；批量队列会将其标记为跳过，不会重复执行。"}},"en":{"stringUnit":{"state":"translated","value":"Some selected simulators are already running another operation. The batch queue will skip them instead of running a duplicate operation."}}}},
